+    const dpr = Math.min(window.devicePixelRatio || 1, 2);
+
+    function resize() {
+      width = window.innerWidth;
+      height = window.innerHeight;
+      sizeRef.current = { width, height };
+      canvas!.width = width * dpr;
+      canvas!.height = height * dpr;
+      canvas!.style.width = width + "px";
+      canvas!.style.height = height + "px";
+      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
+    }
+    resize();
+    window.addEventListener("resize", resize);
+
+    function explodeRocket(rocket: Rocket, big: boolean) {
+      burstsRef.current.push(createBurst(rocket.x, rocket.y, rocket.color, big));
+      if (burstsRef.current.length > 10) burstsRef.current.shift();
+    }
+
+    function handlePointer(e: PointerEvent) {
+      const rect = canvas!.getBoundingClientRect();
+      const x = e.clientX - rect.left;
+      const rocket = createRocket(width, height, x);
+      rocket.targetY = e.clientY - rect.top;
+      rocketsRef.current.push(rocket);
+    }
+    window.addEventListener("pointerdown", handlePointer);
+
+    // Custom events to control fireworks from outside (start/stop/burst)
+    function onStart() {
+      activeRef.current = true;
+    }
+    function onStop() {
+      activeRef.current = false;
+    }
+    function onBurst(e: Event) {
+      const ev = e as CustomEvent<{ x?: number; y?: number; big?: boolean }>;
+      const rect = canvas!.getBoundingClientRect();
+      const x = ev.detail?.x ?? rect.width / 2;
+      const y = ev.detail?.y ?? rect.height / 2;
+      const big = !!ev.detail?.big;
+      burstsRef.current.push(createBurst(x, y, randomColor(), big));
+    }
+
+    window.addEventListener("fireworks:start", onStart as EventListener);
+    window.addEventListener("fireworks:stop", onStop as EventListener);
+    window.addEventListener("fireworks:burst", onBurst as EventListener);
+
+    function tick(timestamp: number) {
+      ctx!.clearRect(0, 0, width, height);
+
+      if (activeRef.current) {
+        if (timestamp - lastLaunchRef.current > 420 + Math.random() * 520) {
+          rocketsRef.current.push(createRocket(width, height));
+          lastLaunchRef.current = timestamp;
+        }
+      }
+
+      rocketsRef.current = rocketsRef.current.filter((rocket) => {
+        if (rocket.exploded) return false;
+
+        rocket.x += rocket.vx;
