+        rocket.vy += 0.05;
+
+        rocket.trail.push({ x: rocket.x, y: rocket.y });
+        if (rocket.trail.length > 12) rocket.trail.shift();
+
+        rocket.trail.forEach((point, idx) => {
+          const alpha = (idx / rocket.trail.length) * 0.5;
+          ctx!.beginPath();
